{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2024",
        "jsx": "react-jsx",
        "allowImportingTsExtensions": true,
        "checkJs": false,
        "experimentalDecorators": false,
        "strictNullChecks": false,
        "strictFunctionTypes": false,
        "strict": false
    },
    "exclude": [
        "node_modules",
        "**/node_modules/*",
    ]
}